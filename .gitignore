# Serving artifact of the web app: rebuilt from committed data in ~26s by
# `python3 build_webdb.py`, so it is derived, not source.
data/refresh.db
data/refresh.db-wal
data/refresh.db-shm

# Reference checkout of the private Lemali-Consulting/pgh-ghost-bus repo, kept
# here for its stack and patterns. This repo is public and that one is not, so
# it is a gitignored plain clone rather than a real submodule -- a submodule
# would commit .gitmodules with a private URL and break clones for anyone
# without access. Refresh with: git -C pgh-ghost-bus pull
pgh-ghost-bus/

# 2020 Census redistricting file for all of Pennsylvania (57 MB), the source of
# the census blocks that weight coverage inside each block group. Unlike the
# other raw sources this one is NOT committed: it is 57 MB against the 1.2 MB
# of it that this repo actually uses, it needs no key, and it will still be at
# the same URL in ten years. `python3 ingest_census.py` re-fetches it and
# rebuilds data/census_blocks.csv, which IS committed.
# https://www2.census.gov/programs-surveys/decennial/2020/data/01-Redistricting_File--PL_94-171/Pennsylvania/pa2020.pl.zip
data/raw/census/pa2020.pl.zip

# Playwright MCP session artifacts (screenshots, snapshots) -- never part of the repo.
.playwright-mcp/
